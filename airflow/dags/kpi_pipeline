from airflow import DAG
from airflow.operators.python import PythonOperator
from datetime import datetime
import psycopg2

def recalcul_kpi():
    conn = psycopg2.connect(
        host="host.docker.internal",
        database="economie",
        user="postgres",
        password="postgres",
        port="5432"
    )

    cur = conn.cursor()

    cur.execute("CALL recalcul_kpi();")

    conn.commit()

    cur.close()
    conn.close()

with DAG(
    dag_id='inflation_kpi_pipeline',
    start_date=datetime(2026,5,14),
    schedule_interval='*/1 * * * *',
    catchup=False
) as dag:

    task1 = PythonOperator(
        task_id='recalcul_kpi',
        python_callable=recalcul_kpi
    )
